@using Mission06_Roland.Models
@model AddMovie

<h1>Movie Entry Form</h1>

<form id="movieForm" method="post">
    <div class="form-group">
        <label asp-for="title" class="required">Title</label>
        <input asp-for="title" type="text" id="title" name="title" required>
    </div>

    <div class="form-group">
        <label asp-for="category" class="required">Category</label>
        <input asp-for="category" type="text" id="category" name="category" required>
    </div>

    <div class="form-group">
        <label asp-for="year" class="required">Year</label>
        <input asp-for="year" type="number" id="year" name="year" required>
    </div>

    <div class="form-group">
        <label asp-for="director" class="required">Director</label>
        <input asp-for="director" type="text" id="director" name="director" required>
    </div>

    <div class="form-group">
        <label asp-for="rating" class="required">Rating</label>
        <select asp-for="rating" id="rating" name="rating" required>
            <option value="">Select a rating</option>
            <option value="G">G</option>
            <option value="PG">PG</option>
            <option value="PG-13">PG-13</option>
            <option value="R">R</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="edited">Edited</label>
        <select asp-for="edited" id="edited" name="edited">
            <option value="">Select yes/no</option>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="lentTo">Lent To</label>
        <input asp-for="lentTo" type="text" id="lentTo" name="lentTo">
    </div>

    <div class="form-group">
        <label asp-for="notes">Notes</label>
        <textarea asp-for="notes" id="notes" name="notes" maxlength="25"></textarea>
    </div>

    <button type="submit">Submit</button>
</form>